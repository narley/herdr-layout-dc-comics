{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "dc-chrome"
          },
          "size": {
            "px": 120
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "dc-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "dc-agents"
              },
              "size": {
                "weight": 1.5
              },
              "min": 90
            },
            {
              "id": "tree",
              "type": "block",
              "content": {
                "mod": "dc-tree"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "hidden": true
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "dc-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 82
          }
        }
      ],
      "size": {
        "px": 284
      },
      "min": 44,
      "max": 480,
      "background": {
        "image": "mods/dc-chrome/gotham-sidebar.svg",
        "fit": "cover"
      },
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "dc-tabs"
          },
          "size": {
            "px": 38
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": {
                    "image": "mods/dc-chrome/gotham-backdrop.svg",
                    "fit": "cover"
                  },
                  "border": {
                    "width": 2,
                    "color": "#05070d"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 6,
          "gap": 6
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "dc-status"
          },
          "size": {
            "px": 26
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "dc-comics",
  "terminal_opacity": 0.74,
  "font": "JetBrains Mono",
  "ui_font": "Geist",
  "preview": "layouts/dc-comics.png"
}
